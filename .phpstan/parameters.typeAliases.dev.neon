parameters:
	typeAliases:
		dummy-package-values: '''
			array{
				name: string,
				type?: null|\Pamald\Pamald\DependencyType,
				link?: null|\Pamald\Pamald\DependencyLink,
				environment?: null|\Pamald\Pamald\DependencyEnvironment,
				versionString?: null|string,
				isDirectDependency?: null|bool,
				homepage?: null|string,
				vcsInfo?: null|array<string, mixed>,
				issueTracker?: null|array<string, mixed>,
			}
		'''
		cli-execute-result: '''
			array{
				exitCode: int<0, max>,
				out: string,
				err: string,
			}
		'''
		php-executable: '''
			array{
				enabled: bool,
				envVars?: array<string, ?string>,
				command: array<string>,
			}
		'''
